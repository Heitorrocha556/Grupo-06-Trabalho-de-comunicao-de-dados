--------------------------------------------------------------------------
DEVICE: Multilayer Switch0 / "MLS0"  (3650-24PS, L3 core, HSRP nao usado -
root bridge de todas as VLANs, relay DHCP ativo)
--------------------------------------------------------------------------
!
hostname MLS0
!
ip routing
!
ip dhcp excluded-address 10.80.1.1
ip dhcp excluded-address 10.80.2.1
ip dhcp excluded-address 10.80.3.1
!
ip dhcp pool POOL_ENGENHARIA
 network 10.80.1.0 255.255.255.0
 default-router 10.80.1.1
ip dhcp pool POOL_QUALIDADE
 network 10.80.2.0 255.255.255.0
 default-router 10.80.2.1
ip dhcp pool POOL_SUPORTE
 network 10.80.3.0 255.255.255.0
 default-router 10.80.3.1
!
ip arp inspection vlan 81-83
!
ip dhcp snooping vlan 80-83
no ip dhcp snooping information option
ip dhcp snooping
!
spanning-tree mode rapid-pvst
!
! Uplinks Gi1/0/1-4: trunk para Switch0 / Switch1 / Switch2 / Server0
!
interface GigabitEthernet1/0/1
 ip dhcp snooping trust
 switchport mode trunk
 ip arp inspection trust
!
interface GigabitEthernet1/0/2
 ip dhcp snooping trust
 switchport mode trunk
 ip arp inspection trust
!
interface GigabitEthernet1/0/3
 ip dhcp snooping trust
 switchport mode trunk
 ip arp inspection trust
!
interface GigabitEthernet1/0/4
 ip dhcp snooping trust
 switchport mode trunk
 ip arp inspection trust
!
interface Vlan1
 no ip address
 shutdown
!
interface Vlan80
 mac-address 0001.c9dd.0a01
 ip address 10.80.0.1 255.255.255.0
!
interface Vlan81
 mac-address 0001.c9dd.0a02
 ip address 10.80.1.1 255.255.255.0
 ip helper-address 10.80.0.10
!
interface Vlan82
 mac-address 0001.c9dd.0a03
 ip address 10.80.2.1 255.255.255.0
 ip helper-address 10.80.0.10
!
interface Vlan83
 mac-address 0001.c9dd.0a04
 ip address 10.80.3.1 255.255.255.0
 ip helper-address 10.80.0.10
!
ip classless
!
line con 0
line aux 0
line vty 0 4
 login
!
end


